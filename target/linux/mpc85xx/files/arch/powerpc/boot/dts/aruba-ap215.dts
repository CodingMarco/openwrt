// SPDX-License-Identifier: GPL-2.0-or-later or MIT
//
// Aruba AP-215 Device Tree Source
// Internal codename: Ardmore
//
// SoC: Freescale P1020 (dual-core e500v2)
// WiFi: 2x QCA988x (ath10k) on PCIe
// Flash: 32 MB NOR (CFI) on eLBC
// Ethernet: 2x eTSEC (SGMII)
// TPM: Atmel AT97SC3203 on I2C
// Serial: 9600 baud

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/include/ "fsl/p1020si-pre.dtsi"
/ {
	model = "Aruba AP-215";
	compatible = "aruba,ap-215";

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
		label-mac-device = &enet1;
	};

	chosen {
		bootargs = "console=ttyS0,9600";
		stdout-path = &serial0;
	};

	memory {
		device_type = "memory";
	};

	lbc: localbus@ffe05000 {
		reg = <0 0xffe05000 0 0x1000>;
		ranges = <0x0 0x0 0x0 0xee000000 0x2000000>;

		nor@0,0 {
			compatible = "cfi-flash";
			reg = <0x0 0x0 0x2000000>;
			bank-width = <2>;
			device-width = <1>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				/*
				 * Partition layout needs verification from
				 * a live serial console session (cat /proc/mtd).
				 * Typical Aruba NOR layout for Ardmore:
				 *   apboot, env, env_backup, image0, image1, mfg
				 *
				 * Placeholder layout below - adjust offsets
				 * once confirmed from device.
				 */
				partition@0 {
					reg = <0x0 0x100000>;
					label = "apboot";
					read-only;
				};

				partition@100000 {
					reg = <0x100000 0x80000>;
					label = "env";
				};

				partition@180000 {
					reg = <0x180000 0x80000>;
					label = "env-backup";
				};

				partition@200000 {
					reg = <0x200000 0xe00000>;
					label = "image0";
				};

				partition@1000000 {
					reg = <0x1000000 0xe00000>;
					label = "image1";
				};

				partition@1e00000 {
					reg = <0x1e00000 0x200000>;
					label = "mfg";
					read-only;

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						/*
						 * MAC address offset TBD -
						 * needs reverse engineering of
						 * manufacturing partition format.
						 */
					};
				};
			};
		};
	};

	soc: soc@ffe00000 {
		ranges = <0x0 0x0 0xffe00000 0x100000>;

		i2c@3000 {
			tpm@29 {
				compatible = "atmel,at97sc3203";
				reg = <0x29>;
			};
		};

		gpio0: gpio-controller@fc00 {
		};

		mdio@24000 {
			phy0: ethernet-phy@0 {
				reg = <0x0>;
			};

			phy1: ethernet-phy@1 {
				reg = <0x1>;
			};
		};

		mdio@25000 {
			status = "disabled";
		};

		mdio@26000 {
			status = "disabled";
		};

		ethernet@b0000 {
			status = "disabled";
		};

		ethernet@b1000 {
			phy-handle = <&phy0>;
			phy-connection-type = "sgmii";
		};

		ethernet@b2000 {
			phy-handle = <&phy1>;
			phy-connection-type = "sgmii";
		};

		usb@22000 {
			phy_type = "ulpi";
			dr_mode = "host";
		};

		usb@23000 {
			status = "disabled";
		};
	};

	pci0: pcie@ffe09000 {
		reg = <0 0xffe09000 0 0x1000>;
		ranges = <0x2000000 0x0 0xa0000000 0 0xa0000000 0x0 0x20000000
			  0x1000000 0x0 0x00000000 0 0xffc10000 0x0 0x10000>;
		pcie@0 {
			ranges = <0x2000000 0x0 0xa0000000
				  0x2000000 0x0 0xa0000000
				  0x0 0x20000000

				  0x1000000 0x0 0x0
				  0x1000000 0x0 0x0
				  0x0 0x100000>;

			wifi@0,0 {
				reg = <0x0000 0 0 0 0>;
			};
		};
	};

	pci1: pcie@ffe0a000 {
		reg = <0 0xffe0a000 0 0x1000>;
		ranges = <0x2000000 0x0 0x80000000 0 0x80000000 0x0 0x20000000
			  0x1000000 0x0 0x00000000 0 0xffc00000 0x0 0x10000>;
		pcie@0 {
			ranges = <0x2000000 0x0 0x80000000
				  0x2000000 0x0 0x80000000
				  0x0 0x20000000

				  0x1000000 0x0 0x0
				  0x1000000 0x0 0x0
				  0x0 0x100000>;

			wifi@0,0 {
				reg = <0x0000 0 0 0 0>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status: status {
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			default-state = "on";
		};

		radio_5g_green {
			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <0>;
			linux,default-trigger = "phy0tpt";
		};

		radio_2g_green {
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <1>;
			linux,default-trigger = "phy1tpt";
		};

		radio_5g_amber {
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <0>;
		};

		radio_2g_amber {
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <1>;
		};
	};
};
/include/ "fsl/p1020si-post.dtsi"
